<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="simple_and_join" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <place id="p_start">
      <name><text>source</text></name>
      <initialMarking><text>1</text></initialMarking>
    </place>
    <place id="p1"><name><text>p1</text></name></place>
    <place id="p2"><name><text>p2</text></name></place>
    <place id="p3"><name><text>p3</text></name></place>
    <place id="p_end"><name><text>end</text></name></place>

    <transition id="t1">
      <name><text>A</text></name>
    </transition>
    <transition id="t2">
      <name><text>B</text></name>
    </transition>
    <transition id="t_join">
      <name><text></text></name> <!-- silent AND join -->
    </transition>

    <arc id="a1" source="p_start" target="t1"/>
    <arc id="a2" source="p_start" target="t2"/>
    <arc id="a3" source="t1" target="p1"/>
    <arc id="a4" source="t2" target="p2"/>
    <arc id="a5" source="p1" target="t_join"/>
    <arc id="a6" source="p2" target="t_join"/>
    <arc id="a7" source="t_join" target="p3"/>
    <arc id="a8" source="p3" target="t1"/> <!-- optional: loop for test -->
    <arc id="a9" source="t_join" target="p_end"/>
  </net>
</pnml>
